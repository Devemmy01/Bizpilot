NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

FIREBASE_SERVICE_ACCOUNT={"project_id":"","client_email":"","private_key":""}

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/bizpilot
MONGODB_DB=bizpilot

RESEND_API_KEY=
# Use "Bizpilot <onboarding@resend.dev>" for zero-setup testing (only delivers to your own
# Resend account email) or "Bizpilot <you@yourverifieddomain.com>" once you verify a domain in Resend.
REPORT_FROM_EMAIL=Bizpilot <onboarding@resend.dev>

# Shared secret the /api/cron/reports endpoint checks for (Authorization: Bearer <value>).
# Vercel Cron sends this automatically when CRON_SECRET is set as an env var on the project.
CRON_SECRET=

# Flutterwave — get from https://dashboard.flutterwave.com/settings/apis
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxx

# Push Notifications (VAPID) — generate once with `npx web-push generate-vapid-keys` and never rotate
# (rotating breaks every device that already subscribed)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
